DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# If this stack runs in the same docker-compose project / network as Frigate,
# the default "http://frigate:5000" works as-is (service name resolves via
# docker's internal DNS). If it runs separately (e.g. its own git checkout,
# its own compose stack), point this at Frigate's LAN IP instead, e.g.:
# FRIGATE_URL=http://192.168.0.50:5000
FRIGATE_URL=http://frigate:5000
